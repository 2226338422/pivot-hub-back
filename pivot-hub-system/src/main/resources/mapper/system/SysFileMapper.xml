<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pivothub.system.mapper.SysFileMapper">

    <resultMap id="SysFileResultMap" type="com.pivothub.pojo.po.system.SysFile">
        <id column="uuid" property="uuid"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="extension" property="extension"/>
        <result column="module" property="module"/>
        <result column="type" property="type"/>
        <result column="acl" property="acl"/>
        <result column="uploader_id" property="uploaderId"/>
        <result column="uploader_name" property="uploaderName"/>
        <result column="status" property="status"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="fileColumns">
        uuid, file_name, file_path, file_size, file_type, extension,
        module, type, acl, uploader_id, uploader_name, status,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.pivothub.pojo.po.system.SysFile">
        INSERT INTO sys_file
        (uuid, file_name, file_path, file_size, file_type, extension,
         module, type, acl, uploader_id, uploader_name, status,
         create_user_id, update_user_id)
        VALUES
        (#{uuid}, #{fileName}, #{filePath}, #{fileSize}, #{fileType}, #{extension},
         #{module}, #{type}, #{acl}, #{uploaderId}, #{uploaderName}, #{status},
         #{createUserId}, #{updateUserId})
    </insert>

    <select id="selectByUuids" resultMap="SysFileResultMap">
        SELECT <include refid="fileColumns"/>
        FROM sys_file
        WHERE uuid IN
        <foreach collection="uuids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND status = 1
    </select>

    <select id="selectFirstByType" resultMap="SysFileResultMap">
        SELECT <include refid="fileColumns"/>
        FROM sys_file
        WHERE type = #{type} AND status = 1
        ORDER BY create_time ASC
        LIMIT 1
    </select>
</mapper>
